# Server-side OAuth configuration. Keep client secrets private.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4173/oauth/callback
PORT=4173
# Bind address. Default 127.0.0.1 (this computer only).
# Set RELAY_BIND=0.0.0.0 to allow other devices on your LAN.
# RELAY_BIND=127.0.0.1
# Optional secret required for non-loopback control API calls when LAN bind is enabled.
# RELAY_API_TOKEN=
# Optional override for tokens/settings/chat/activity. Packaged default is a data folder beside the exe.
# RELAY_DATA_DIR=
# How many chat lines to keep in memory and in data/chat.json.
# Default 5000. Range 100–1000000.
# A higher number costs more RAM and makes chat.json bigger; a lower number is
# cheaper but means the dock empties sooner after a restart. 5000 is enough for
# a normal stream day. High-volume streams may want 50000 or more.
# RELAY_CHAT_MAX=5000
# Optional Kick API base. Default is https://api.kick.com/public/v1
# KICK_API_BASE=

# Chat translation.
# With nothing set below, the app uses Google's unofficial translator
# (client=gtx) — no key needed, but it is unofficial and Google may block it.
# Set one of the following to switch to a supported provider:
# TRANSLATE_API_KEY=       # Google Cloud Translation API key (official), or LibreTranslate api_key
# TRANSLATE_URL=           # LibreTranslate-compatible endpoint, e.g. https://libretranslate.com/translate

# StreamElements activity (source of truth for the Activity dock).
# Dashboard → avatar → switch to that platform's channel → Show secrets.
# JWTs last weeks, not hours. Paste a new one if StreamElements rotates it.
STREAMELEMENTS_JWT_TWITCH=
STREAMELEMENTS_JWT_KICK=
STREAMELEMENTS_JWT_YOUTUBE=
