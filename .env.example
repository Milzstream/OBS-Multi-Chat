# Server-side OAuth configuration. Keep client secrets private.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:4173/oauth/callback
PORT=4173
# Bind address. Default 127.0.0.1 (this computer only).
# Set RELAY_BIND=0.0.0.0 to allow other devices on your LAN.
# RELAY_BIND=127.0.0.1
# Optional secret required for non-loopback control API calls when LAN bind is enabled.
# RELAY_API_TOKEN=
# Optional override for tokens/settings/chat/activity. Packaged default is a data folder beside the exe.
# RELAY_DATA_DIR=
# Optional: Kick API base URL for the current Kick developer API.
KICK_API_BASE=

# StreamElements activity (source of truth for the Activity dock).
# Dashboard → avatar → switch to that platform's channel → Show secrets.
# JWTs last weeks, not hours. Paste a new one if StreamElements rotates it.
STREAMELEMENTS_JWT_TWITCH=
STREAMELEMENTS_JWT_KICK=
STREAMELEMENTS_JWT_YOUTUBE=
